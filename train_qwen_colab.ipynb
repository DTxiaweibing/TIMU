   "source": [
    "# Qwen2.5-0.5B 微调（LLaMA-Factory + Colab）\n",
    "\n",
    "在 Google Colab **免费 GPU** 上跑，全程自动。\n",
    "\n",
    "## 使用步骤\n",
    "1. 菜单 → **Runtime → Change runtime type → T4 GPU**\n",
    "2. 点击左侧 ▶ 全部运行\n",
    "3. 等跑完（约 30-60 分钟），结果自动保存到你的 Google Drive\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# @title 1. 挂载 Google Drive（保存结果）\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "print('✅ Drive 挂载成功')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# @title 2. 安装 LLaMA-Factory\n",
    "!pip install -q llama-factory[torch] torch transformers datasets accelerate peft\n",
    "print('✅ 依赖安装完成')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# @title 3. 下载训练数据\n",
    "import requests\n",
    "import json\n",
    "\n",
    "url = 'https://raw.githubusercontent.com/DTxiaweibing/TIMU/main/kb_source/train_data.jsonl'\n",
    "r = requests.get(url)\n",
    "\n",
    "with open('train_data.jsonl', 'wb') as f:\n",
    "    f.write(r.content)\n",
    "\n",
    "count = sum(1 for _ in open('train_data.jsonl'))\n",
    "print(f'✅ 下载完成，共 {count} 条数据')\n",
    "\n",
    "# 看一眼样例\n",
    "with open('train_data.jsonl') as f:\n",
    "    sample = json.loads(f.readline())\n",
    "print(f'样例：\\n{json.dumps(sample, ensure_ascii=False, indent=2)[:300]}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# @title 4. 启动微调（LoRA，Qwen2.5-0.5B）\n",
    "!llamafactory-cli train \\\n",
    "  --model_name_or_path Qwen/Qwen2.5-0.5B \\\n",
    "  --stage sft \\\n",
    "  --do_train True \\\n",
    "  --finetuning_type lora \\\n",
    "  --dataset_dir ./ \\\n",
    "  --dataset train_data.jsonl \\\n",
    "  --template qwen \\\n",
    "  --cutoff_len 1024 \\\n",
    "  --output_dir /content/drive/MyDrive/qwen_timu_checkpoint \\\n",
    "  --overwrite_cache True \\\n",
    "  --per_device_train_batch_size 4 \\\n",
    "  --gradient_accumulation_steps 4 \\\n",
    "  --lr_scheduler_type cosine \\\n",
    "  --logging_steps 10 \\\n",
    "  --save_steps 200 \\\n",
    "  --learning_rate 5e-5 \\\n",
    "  --num_train_epochs 3.0 \\\n",
    "  --fp16 True \\\n",
    "  --lora_rank 8 \\\n",
    "  --lora_alpha 16 \\\n",
    "  --lora_dropout 0.1 \\\n",
    "  --lora_target q_proj,k_proj,v_proj,o_proj \\\n",
    "  --plot_loss True\n",
    "\n",
    "print('✅ 训练完成！')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# @title 5. 合并 LoRA → 完整模型（可选，用于 Android 端）\n",
    "!llamafactory-cli export \\\n",
    "  --model_name_or_path Qwen/Qwen2.5-0.5B \\\n",
    "  --adapter_name_or_path /content/drive/MyDrive/qwen_timu_checkpoint \\\n",
    "  --template qwen \\\n",
    "  --finetuning_type lora \\\n",
    "  --export_dir /content/drive/MyDrive/qwen_timu_merged \\\n",
    "  --export_size 2 \\\n",
    "  --export_legacy_format False\n",
    "\n",
    "print('✅ 模型合并完成！')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
